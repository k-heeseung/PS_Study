#include <iostream>

using namespace std;

int n, cnt;
int isused1[20], isused2[35], isused3[35];

void func(int cur){
    if (cur == n){
        cnt++;
        return;
    }
    for (int i=0; i<n; i++){
        if (!isused1[i] && !isused2[cur+i] && !isused3[cur-i+n-1]){
            isused1[i] = 1; // 같은 열
            isused2[cur+i] = 1; // 같은 우상향 대각선
            isused3[cur-i+n-1] = 1; // 같은 우하향 대각선
            func(cur+1);
            isused1[i] = 0;
            isused2[cur+i] = 0;
            isused3[cur-i+n-1] = 0;
        }
    }
}

int main()
{
    cin >> n;
    func(0);
    cout << cnt;
    
    return 0;
}
